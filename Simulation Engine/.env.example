# Copy to .env (cp .env.example .env) and edit. NEVER commit .env.
DB_BACKEND=sqlite              # sqlite | dynamodb
AWS_REGION=ap-southeast-2      # your account only allows this region
# DDB_TABLE_PREFIX=p2p_        # change if several people share one AWS account
# DDB_ENDPOINT=                # only for DynamoDB Local, e.g. http://dynamodb-local:8000
# AWS_ACCESS_KEY_ID=           # only when NOT running on EC2/ECS with an IAM role
# AWS_SECRET_ACCESS_KEY=
# FORECAST_URL=http://agent-host:port/predict   # the ML agent; engine falls back to its baseline if unset/down
# ADMIN_TOKEN=change-me        # if set, every POST/PATCH/DELETE needs header X-Admin-Token
# READINGS_CSV=                # optional dataset file path inside the container
