{
  "family": "p2p-simulation-engine",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::667958380608:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "p2p-simulation-engine",
      "image": "667958380608.dkr.ecr.us-east-1.amazonaws.com/p2p-simulation-engine:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "DB_BACKEND",
          "value": "dynamodb"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "DDB_TABLE_PREFIX",
          "value": "p2p_"
        },
        {
          "name": "FORECAST_URL",
          "value": "http://p2p-ml-engine.p2p-cluster.local:8000/predict"
        }
      ],
      "secrets": [
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "FRIENDS_SECRET_ARN:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "FRIENDS_SECRET_ARN:AWS_SECRET_ACCESS_KEY::"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "valueFrom": "FRIENDS_SECRET_ARN:AWS_DEFAULT_REGION::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/p2p-simulation-engine",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
